# ──────────────────────────────────────────────
# TokayOps - Environment Variables
# Copy to .env and fill in values before starting
# ──────────────────────────────────────────────

# ── Required ──────────────────────────────────

# AES-256 encryption key for integration secrets (64 hex chars)
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# JWT signing secret (any random string; REQUIRED when APP_ENV=production)
# Generate: openssl rand -base64 32
JWT_SECRET=

# ── Database ──────────────────────────────────

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=tokay
DB_SSLMODE=disable

# ── Application ───────────────────────────────

# How many days the history of finished deliveries is kept; 0 keeps it for good.
# TOKAY_DELIVERY_RETENTION_DAYS=30

# Set to "production" to enable secure cookies, CSRF, and require JWT_SECRET.
# Any real deployment wants "production" here.
APP_ENV=development

# Explicit CSRF toggle (auto-enabled when APP_ENV=production)
# CSRF_ENABLED=true

# Public base URL. Required in practice: without it the Slack/Telegram
# Ack/Resolve buttons are hidden, the Telegram webhook is not registered, and
# Telegram account linking cannot complete.
# TOKAY_SELF_URL=https://tokayops.example.com

# Session duration (Go duration format)
# SESSION_DURATION=168h

# ── Ports ─────────────────────────────────────

# Main API server is always on :8080 inside the container (not configurable)
# Internal server (health + metrics) port:
INTERNAL_PORT=9090

# ── docker-compose.prod.yml only ──────────────
# These are read by Compose, not by the application.

# Image tag to run. `latest` (the default) follows the newest stable release,
# `0.1.0` pins that release, `0.1` follows its patches, `develop` follows the
# develop branch. To pin a digest instead, edit the `image:` line in
# docker-compose.prod.yml - a digest does not fit here.
# TOKAY_TAG=latest

# Host port the API and UI are published on (container side stays 8080)
# TOKAY_PORT=8080

# ── Config file ───────────────────────────────

# Path to tokay.yaml (default: tokay.yaml in working directory)
# CONFIG_FILE=tokay.yaml

# ── OIDC / SSO (optional) ────────────────────

# OIDC_ISSUER_URL=https://accounts.google.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_ALLOWED_DOMAINS=example.com,company.com
